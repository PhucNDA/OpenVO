ninja_required_version = 1.3
cxx = /fs/nexus-projects/AD_dashrecon/miniconda3/envs/openvo/bin/x86_64-conda-linux-gnu-c++
nvcc = /fs/nexus-projects/AD_dashrecon/miniconda3/envs/processor/bin/nvcc

cflags = -Wno-unused-result -Wsign-compare -DNDEBUG -O2 -Wall -fPIC -O2 -isystem /fs/nexus-projects/AD_dashrecon/miniconda3/envs/openvo/include -I/fs/nexus-projects/AD_dashrecon/miniconda3/envs/openvo/include -fPIC -O2 -isystem /fs/nexus-projects/AD_dashrecon/miniconda3/envs/openvo/include -march=nocona -mtune=haswell -ftree-vectorize -fPIC -fstack-protector-strong -fno-plt -O2 -ffunction-sections -pipe -isystem /fs/nexus-projects/AD_dashrecon/miniconda3/envs/openvo/include -DNDEBUG -D_FORTIFY_SOURCE=2 -O2 -isystem /fs/nexus-projects/AD_dashrecon/miniconda3/envs/openvo/include -fPIC -I/fs/nexus-projects/AD_dashrecon/miniconda3/envs/openvo/lib/python3.9/site-packages/torch/include -I/fs/nexus-projects/AD_dashrecon/miniconda3/envs/openvo/lib/python3.9/site-packages/torch/include/torch/csrc/api/include -I/fs/nexus-projects/AD_dashrecon/miniconda3/envs/openvo/lib/python3.9/site-packages/torch/include/TH -I/fs/nexus-projects/AD_dashrecon/miniconda3/envs/openvo/lib/python3.9/site-packages/torch/include/THC -I/fs/nexus-projects/AD_dashrecon/miniconda3/envs/processor/include -I/fs/nexus-projects/AD_dashrecon/miniconda3/envs/openvo/include/python3.9 -c
post_cflags = -std=c++14 -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=correlation_cuda -D_GLIBCXX_USE_CXX11_ABI=0
cuda_cflags = -I/fs/nexus-projects/AD_dashrecon/miniconda3/envs/openvo/lib/python3.9/site-packages/torch/include -I/fs/nexus-projects/AD_dashrecon/miniconda3/envs/openvo/lib/python3.9/site-packages/torch/include/torch/csrc/api/include -I/fs/nexus-projects/AD_dashrecon/miniconda3/envs/openvo/lib/python3.9/site-packages/torch/include/TH -I/fs/nexus-projects/AD_dashrecon/miniconda3/envs/openvo/lib/python3.9/site-packages/torch/include/THC -I/fs/nexus-projects/AD_dashrecon/miniconda3/envs/processor/include -I/fs/nexus-projects/AD_dashrecon/miniconda3/envs/openvo/include/python3.9 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -gencode arch=compute_50,code=sm_50 -gencode arch=compute_52,code=sm_52 -gencode arch=compute_60,code=sm_60 -gencode arch=compute_61,code=sm_61 -gencode arch=compute_70,code=sm_70 -gencode arch=compute_70,code=compute_70 -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=correlation_cuda -D_GLIBCXX_USE_CXX11_ABI=0 -ccbin /fs/nexus-projects/AD_dashrecon/miniconda3/envs/openvo/bin/x86_64-conda-linux-gnu-cc -std=c++17
cuda_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc  $cuda_cflags -c $in -o $out $cuda_post_cflags





build /fs/nexus-projects/AD_dashrecon/ADVO/OpenVO/src/model/correlation_package/build/temp.linux-x86_64-3.9/correlation_cuda.o: compile /fs/nexus-projects/AD_dashrecon/ADVO/OpenVO/src/model/correlation_package/correlation_cuda.cc
build /fs/nexus-projects/AD_dashrecon/ADVO/OpenVO/src/model/correlation_package/build/temp.linux-x86_64-3.9/correlation_cuda_kernel.o: cuda_compile /fs/nexus-projects/AD_dashrecon/ADVO/OpenVO/src/model/correlation_package/correlation_cuda_kernel.cu







